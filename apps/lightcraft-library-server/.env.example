# Change this to the path of a new, dedicated folder on the Synology volume.
LIGHTCRAFT_DATA_PATH=/volume1/docker/lightcraft-library-poc

# Folder containing the files produced by `cargo xtask web` on the development computer.
LIGHTCRAFT_WEB_SITE_PATH=/volume1/docker/lightcraft-web-site

# API base URL embedded in the Docker-served Web app (query ?remote= takes precedence).
LIGHTCRAFT_REMOTE_URL=https://lightcraft-api.example.net

# Browser RAW/develop workers; query ?workers=0..4 overrides this default.
LIGHTCRAFT_WEB_WORKERS=2

# Replace with a private random secret (at least 32 characters).
LIGHTCRAFT_API_TOKEN=replace-with-a-private-random-secret-of-32-characters-or-more

# Recovery window if a browser tab is suspended (allowed range: 45-300 seconds).
LIGHTCRAFT_LEASE_SECONDS=300

# Exact browser origin, including scheme and port if present (no path).
# For local Web development, use http://127.0.0.1:8080; for NAS-hosted Web, use its HTTPS origin.
LIGHTCRAFT_ALLOWED_ORIGIN=https://lightcraft.example.net
